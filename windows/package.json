{
  "name": "snowdesk",
  "version": "1.0.0",
  "description": "SnowDesk - weather effects for your Windows desktop",
  "main": "main.cjs",
  "type": "module",
  "author": "SnowDesk",
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "resedit": "^3.1.0"
  },
  "dependencies": {
    "koffi": "^2.9.2"
  },
  "scripts": {
    "bundle": "esbuild src/overlay.js --bundle --format=iife --minify --outfile=dist/overlay.js",
    "icons": "node tools/make_icons.mjs",
    "start": "npm run bundle && electron .",
    "selftest": "npm run bundle && electron . --selftest",
    "dist": "npm run bundle && npm run icons && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.snowdesk.app",
    "productName": "SnowDesk",
    "asar": false,
    "afterPack": "tools/afterPack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "overlay.html",
      "package.json",
      "src/win32.cjs",
      "dist/overlay.js",
      "assets/**",
      "!node_modules/koffi/build/koffi/{darwin_arm64,darwin_x64,freebsd_arm64,freebsd_ia32,freebsd_x64,linux_arm32,linux_arm64,linux_ia32,linux_riscv64,linux_x64,musl_x64,openbsd_ia32,openbsd_x64,win32_arm64,win32_ia32}/**",
      "!node_modules/koffi/{src,doc,vendor}/**",
      "!node_modules/koffi/**/*.{md,ts}"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SnowDesk",
      "runAfterFinish": true,
      "artifactName": "SnowDesk-Setup-${version}.${ext}"
    }
  }
}